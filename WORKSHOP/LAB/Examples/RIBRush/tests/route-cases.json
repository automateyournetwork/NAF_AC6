  "routeEvaluationCases": [
    {
      "name": "IPv4 longest prefix beats a lower-AD broad route",
      "destination": "192.0.2.42",
      "routes": [
        {
          "id": "static-broad",
          "addressFamily": "ipv4",
          "networkAddress": "192.0.0.0",
          "prefixLength": 16,
          "protocol": "static",
          "administrativeDistance": 1,
          "metric": null,
          "nextHopId": "broad"
        },
        {
          "id": "ospf-specific",
          "addressFamily": "ipv4",
          "networkAddress": "192.0.2.0",
          "prefixLength": 24,
          "protocol": "ospf",
          "administrativeDistance": 110,
          "metric": null,
          "nextHopId": "specific"
        }
      ],
      "expected": {
        "status": "winner",
        "winnerRouteId": "ospf-specific",
        "ruleCode": "longest-prefix"
      }
    },
    {
      "name": "same-prefix AD chooses the lower Cisco value",
      "destination": "203.0.113.42",
      "routes": [
        {
          "id": "same-prefix-static",
          "addressFamily": "ipv4",
          "networkAddress": "203.0.113.0",
          "prefixLength": 24,
          "protocol": "static",
          "administrativeDistance": 1,
          "metric": null,
          "nextHopId": "static"
        },
        {
          "id": "same-prefix-ospf",
          "addressFamily": "ipv4",
          "networkAddress": "203.0.113.0",
          "prefixLength": 24,
          "protocol": "ospf",
          "administrativeDistance": 110,
          "metric": null,
          "nextHopId": "ospf"
        }
      ],
      "expected": {
        "status": "winner",
        "winnerRouteId": "same-prefix-static",
        "ruleCode": "administrative-distance"
      },
      "expectedEvidence": {
        "adComparison.winningDistance": 1,
        "adComparison.candidateDistances": [1, 110]
      }
    },
